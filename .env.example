# Copy this file to .env for local testing (Render uses its own
# Environment tab instead of this file — see README.md).

# Your MongoDB Atlas connection string. In Atlas: Database > Connect >
# "Drivers" > copy the string, then replace <password> with your real
# database user password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Any long random string — used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Render sets PORT automatically; only needed for local runs.
PORT=4173
